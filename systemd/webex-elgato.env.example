# Copy to ~/.config/webex-elgato.env and chmod 600.
# Lines are KEY=value (no export, no quotes unless the value contains spaces).
#
# OAuth (recommended for always-on hosts):
#   Run once:  cd ~/webex-elgato && ./webex-elgato-login.sh setup
#   Tokens are stored in ~/.config/webex-elgato/ (not in this file).
#   Re-login:  ./webex-elgato-login.sh login
#
# Optional advanced overrides (normally set by setup wizard):
# WEBEX_CLIENT_ID=your_integration_client_id
# WEBEX_CLIENT_SECRET=your_integration_client_secret
#
# Quick test only — personal access token (expires ~12 hours):
# WEBEX_ACCESS_TOKEN=replace_with_personal_access_token
#
# Identity: pick ONE (person id wins over email if both are set; omit both to use /people/me).
# WEBEX_PERSON_ID=Y2lzY29zcGFyazovL3VzL1BFT1BMRS8...
# WEBEX_EMAIL=you@example.com
#
# Optional tuning:
# WEBEX_ELGATO_POLL_SECONDS=10
# WEBEX_ELGATO_DISCOVER_SECONDS=2
# WEBEX_ELGATO_OFF_AFTER_POLLS=3
# WEBEX_ELGATO_OFFLINE_SECONDS=1800

# Copy to ~/.config/webex-elgato.env and chmod 600.
# Lines are KEY=value (no export, no quotes unless the value contains spaces).

WEBEX_ACCESS_TOKEN=replace_with_personal_access_token

# Identity: pick ONE (person id wins over email if both are set; omit both to use /people/me).
# WEBEX_PERSON_ID=Y2lzY29zcGFyazovL3VzL1BFT1BMRS8...
# WEBEX_EMAIL=you@example.com

# Optional (same as shell):
# WEBEX_ELGATO_POLL_SECONDS=10
# WEBEX_ELGATO_DISCOVER_SECONDS=2
# WEBEX_ELGATO_OFF_AFTER_POLLS=3
